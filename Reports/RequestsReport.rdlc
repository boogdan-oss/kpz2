        </Paragraphs>
        <Top>0.8in</Top>
        <Left>0in</Left>
        <Height>0.26in</Height>
        <Width>10.6in</Width>
        <Style>
          <VerticalAlign>Middle</VerticalAlign>
          <PaddingLeft>4pt</PaddingLeft>
          <PaddingRight>4pt</PaddingRight>
          <PaddingTop>4pt</PaddingTop>
          <PaddingBottom>4pt</PaddingBottom>
        </Style>
      </Textbox>
      <Chart Name="SummaryChart">
        <ChartCategoryHierarchy>
          <ChartMembers>
            <ChartMember>
              <Group Name="SummaryCategory">
                <GroupExpressions>
                  <GroupExpression>=Fields!Category.Value</GroupExpression>
                </GroupExpressions>
              </Group>
              <Label>=Fields!Category.Value</Label>
            </ChartMember>
          </ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers>
            <ChartMember>
              <Label>Кількість</Label>
            </ChartMember>
          </ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="TotalSeries">
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues>
                    <Y>=Sum(Fields!Total.Value)</Y>
                  </ChartDataPointValues>
                  <ChartDataLabel>
                    <Visible>true</Visible>
                    <UseValueAsLabel>true</UseValueAsLabel>
                    <Style>
                      <FontSize>9pt</FontSize>
                    </Style>
                  </ChartDataLabel>
                </ChartDataPoint>
              </ChartDataPoints>
              <Type>Bar</Type>
              <Subtype>Plain</Subtype>
              <ChartAreaName>MainArea</ChartAreaName>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <ChartAreas>
          <ChartArea Name="MainArea">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary">
                <Interval>1</Interval>
                <Reverse>true</Reverse>
                <Style>
                  <FontSize>9pt</FontSize>
                </Style>
              </ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary">
                <Minimum>0</Minimum>
                <IncludeZero>true</IncludeZero>
                <Style>
                  <Format>0</Format>
                </Style>
              </ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <Palette>BrightPastel</Palette>
        <DataSetName>StatsData</DataSetName>
        <Top>1.10in</Top>
        <Left>0in</Left>
        <Height>2.40in</Height>
        <Width>10.6in</Width>
        <ChartNoDataMessage Name="NoChartData">
          <Caption>Немає даних за вибраними умовами</Caption>
        </ChartNoDataMessage>
        <Style>
          <BackgroundColor>White</BackgroundColor>
        </Style>
      </Chart>
      <Textbox Name="RowCountLabel">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Записів у таблиці: " &amp; CountRows("MainData")</Value>
                <Style>
                  <FontFamily>Arial</FontFamily>
                  <FontSize>10pt</FontSize>
                  <Color>#172033</Color>
                  <FontWeight>Bold</FontWeight>
                </Style>
