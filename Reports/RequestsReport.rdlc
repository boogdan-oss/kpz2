<?xml version='1.0' encoding='UTF-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="LocalData">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>Local in-memory data</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="MainData">
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FullName">
          <DataField>FullName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Goal">
          <DataField>Goal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Intensity">
          <DataField>Intensity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SessionsPerWeek">
          <DataField>SessionsPerWeek</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ExperienceAtRequest">
          <DataField>ExperienceAtRequest</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CreatedAt">
          <DataField>CreatedAt</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>LocalData</DataSourceName>
        <CommandText></CommandText>
      </Query>
    </DataSet>
    <DataSet Name="StatsData">
      <Fields>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>LocalData</DataSourceName>
        <CommandText></CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="ReportTitle">
      <DataType>String</DataType>
      <Prompt>ReportTitle</Prompt>
    </ReportParameter>
    <ReportParameter Name="ReportSubtitle">
      <DataType>String</DataType>
      <Prompt>ReportSubtitle</Prompt>
    </ReportParameter>
    <ReportParameter Name="ChartTitle">
      <DataType>String</DataType>
      <Prompt>ChartTitle</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Body>
    <ReportItems>
      <Textbox Name="ReportHeading">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!ReportTitle.Value</Value>
                <Style>
                  <FontFamily>Arial</FontFamily>
                  <FontSize>18pt</FontSize>
                  <Color>#172033</Color>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0in</Top>
        <Left>0in</Left>
        <Height>0.36in</Height>
        <Width>10.6in</Width>
        <Style>
          <VerticalAlign>Middle</VerticalAlign>
          <PaddingLeft>4pt</PaddingLeft>
          <PaddingRight>4pt</PaddingRight>
          <PaddingTop>4pt</PaddingTop>
          <PaddingBottom>4pt</PaddingBottom>
        </Style>
      </Textbox>
      <Textbox Name="ReportSubheading">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!ReportSubtitle.Value</Value>
                <Style>
                  <FontFamily>Arial</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Color>#526176</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.4in</Top>
        <Left>0in</Left>
        <Height>0.3in</Height>
        <Width>10.6in</Width>
        <Style>
          <VerticalAlign>Middle</VerticalAlign>
          <PaddingLeft>4pt</PaddingLeft>
          <PaddingRight>4pt</PaddingRight>
          <PaddingTop>4pt</PaddingTop>
          <PaddingBottom>4pt</PaddingBottom>
        </Style>
      </Textbox>
      <Textbox Name="ChartHeading">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!ChartTitle.Value</Value>
                <Style>
                  <FontFamily>Arial</FontFamily>
                  <FontSize>11pt</FontSize>
                  <Color>#172033</Color>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
